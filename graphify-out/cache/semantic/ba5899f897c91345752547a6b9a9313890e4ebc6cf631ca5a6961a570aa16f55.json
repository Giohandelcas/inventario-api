rce_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prisma_schema_auditaction", "label": "AuditAction (enum)", "file_type": "code", "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prisma_er_diagram_stock_source_of_truth", "label": "ProductVariant.stock Source-of-Truth Pattern", "file_type": "rationale", "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "stock is stored as a field, not derived by summing InventoryMovement on each read, for performance in catalog listings (RNF-06); always updated within the same DB transaction that inserts the InventoryMovement row (RNF-01) so balance and history never diverge."}, {"id": "prisma_er_diagram_inventorymovement_append_only", "label": "InventoryMovement Append-Only Pattern", "file_type": "rationale", "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "InventoryMovement rows are never edited or deleted; corrections are made via new adjustment movements (AJUSTE_ENTRADA/AJUSTE_SALIDA), making the RF-04 history and RF-12 audit trail reliable."}, {"id": "prisma_er_diagram_guest_checkout", "label": "Guest Checkout via Nullable Customer.passwordHash", "file_type": "rationale", "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Customer.passwordHash is nullable to support guest checkout (RF-17/RF-19): an order always requires a Customer, but it can be created with just email/name/phone at checkout time without an account; if the customer registers later, passwordHash is filled on the same record found by email."}, {"id": "prisma_er_diagram_auditlog_polymorphic", "label": "AuditLog Polymorphic entityType/entityId Design", "file_type": "rationale", "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AuditLog uses generic entityType + entityId instead of a FK per auditable entity type, to avoid touching the schema every time a new table needs auditing."}, {"id": "prisma_er_diagram_category_self_referential", "label": "Category Self-Referential Subcategories", "file_type": "rationale", "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Category has a self-relation (parentId) to support one additional level of subcategory nesting (RF-06) in v1; an arbitrarily deep tree was not modeled because requerimientos.md doesn't call for it."}, {"id": "prisma_er_diagram_decimal_for_money", "label": "Decimal (not Float) for Monetary Amounts", "file_type": "rationale", "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All money fields (cost, basePrice, unitCost, unitPrice, subtotal, total) use Decimal instead of Float to avoid rounding errors in financial calculations."}, {"id": "prisma_er_diagram_immediate_stock_decrement", "label": "RF-18: Immediate Stock Decrement (No Reservation)", "file_type": "rationale", "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On order confirmation, ProductVariant.stock is decremented in the same transaction that creates the Order, its OrderItems and the InventoryMovement (VENTA_SALIDA) - no intermediate 'reserved' state or TTL reservation table. Concurrent buyers competing for the same variant require reading stock with a lock (SELECT ... FOR UPDATE or Serializable isolation) and rejecting the sale if insufficient, to satisfy RNF-01 and avoid overselling."}], "edges": [{"source": "prisma_er_diagram_doc", "target": "prisma_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "weight": 1.0}, {"source": "prisma_er_diagram_doc", "target": "requerimientos_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "weight": 1.0}, {"source": "prisma_schema_purchaseorder", "target": "prisma_schema_user", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "weight": 1.0}, {"source": "prisma_schema_inventorymovement", "target": "prisma_schema_user", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "weight": 1.0}, {"source": "prisma_schema_auditlog", "target": "prisma_schema_user", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "weight": 1.0}, {"source": "prisma_schema_order", "target": "prisma_schema_customer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "weight": 1.0}, {"source": "prisma_schema_category", "target": "prisma_schema_category", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "weight": 1.0}, {"source": "prisma_schema_product", "target": "prisma_schema_category", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prisma/ER-DIAGRAM.md", "source_location": null, "weight": 1.0}, {"source": "prisma_schema_productimage", "target": "prisma_schema_product", "relation": "references", "confidence": "EXTRA