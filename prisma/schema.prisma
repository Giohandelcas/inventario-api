// Modelo de datos - Sistema de Inventario + Tienda en Línea
// Ver ../../inventario-app/requerimientos.md (secciones 3 y 6) para el detalle de
// requerimientos funcionales (RF-XX) que motivan cada entidad.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  VENDEDOR
  BODEGA
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum PurchaseOrderStatus {
  BORRADOR
  ORDENADA
  PARCIALMENTE_RECIBIDA
  RECIBIDA
  CANCELADA
}

enum InventoryMovementType {
  COMPRA_ENTRADA // recepción de una orden de compra a proveedor
  VENTA_SALIDA // salida por venta/pedido confirmado
  AJUSTE_ENTRADA // ajuste manual positivo (conteo físico, etc.)
  AJUSTE_SALIDA // ajuste manual negativo (merma, daño, etc.)
  DEVOLUCION_ENTRADA // devolución de cliente
  DEVOLUCION_SALIDA // devolución a proveedor
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// ─── Usuarios internos (RF-09) y clientes (RF-19) ─────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders     PurchaseOrder[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]

  @@map("users")
}

// Cliente de la tienda. passwordHash es nullable porque RF-19 hace el login
// opcional en v1: un pedido de checkout como invitado crea/reutiliza un
// Customer por email sin credenciales; si luego se registra, se setea passwordHash.
model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@map("customers")
}

// ─── Catálogo ───────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToSubcategory")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  categoryId  String
  cost        Decimal  @db.Decimal(12, 2)
  basePrice   Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images    ProductImage[]
  variants  ProductVariant[]
  suppliers ProductSupplier[]

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// RF-02: variantes (talla, color, presentación...) con stock independiente.
// attributes es JSON abierto para no fijar en el schema qué atributos existen
// (varía por categoría de producto: talla/color para ropa, presentación para
// abarrotes, etc.). stock es el campo fuente-de-verdad, mutado únicamente
// dentro de una transacción junto con la creación del InventoryMovement
// correspondiente (RNF-01).
model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  attributes        Json
  priceOverride     Decimal? @db.Decimal(12, 2)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  orderItems         OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// ─── Proveedores y compras (RF-07, RF-08) ──────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products       ProductSupplier[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

// Asociación N:M Producto <-> Proveedor (RF-07), con datos propios de la
// relación (SKU del proveedor, costo pactado con ese proveedor específico).
model ProductSupplier {
  productId   String
  supplierId  String
  supplierSku String?
  cost        Decimal? @db.Decimal(12, 2)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([productId, supplierId])
  @@map("product_suppliers")
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  supplierId   String
  orderedById  String
  status       PurchaseOrderStatus @default(BORRADOR)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderedBy          User                @relation(fields: [orderedById], references: [id], onDelete: Restrict)
  items              PurchaseOrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  productVariantId String
  quantityOrdered  Int
  quantityReceived Int     @default(0)
  unitCost         Decimal @db.Decimal(12, 2)

  purchaseOrder  PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productVariantId])
  @@map("purchase_order_items")
}

// ─── Inventario (RF-03, RF-04, RF-05, RF-12) ───────────────────────────────

// Registro append-only de cada cambio de stock. Cada fila se crea en la misma
// transacción de BD que actualiza ProductVariant.stock (RNF-01), nunca se
// edita ni se borra: es el historial auditable (RF-04) y la fuente para
// reconstruir el stock si hiciera falta.
model InventoryMovement {
  id               String                @id @default(cuid())
  productVariantId String
  type             InventoryMovementType
  quantity         Int // siempre positivo; el signo lo da `type`
  reason           String?
  purchaseOrderId  String?
  orderId          String?
  performedById    String?
  createdAt        DateTime              @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  performedBy    User?          @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([productVariantId])
  @@index([purchaseOrderId])
  @@index([orderId])
  @@map("inventory_movements")
}

// ─── Pedidos de la tienda (RF-10, RF-17, RF-18) ────────────────────────────

model Order {
  id              String      @id @default(cuid())
  customerId      String
  status          OrderStatus @default(PENDIENTE)
  subtotal        Decimal     @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  contactEmail    String
  contactPhone    String?
  shippingAddress Json?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

// ─── Auditoría (RF-12) ──────────────────────────────────────────────────────

// entityType + entityId apuntan genéricamente a cualquier tabla auditada
// (Product, ProductVariant, Order, etc.) en vez de una FK por tipo, para no
// tener que extender el schema cada vez que se audita una entidad nueva.
model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  entityType String
  entityId   String
  action     AuditAction
  changes    Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}
