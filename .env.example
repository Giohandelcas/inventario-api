DATABASE_URL="postgresql://user:password@localhost:5432/inventario"

# Firma los JWT de login interno (Admin/Vendedor/Bodega, src/auth). Generar con:
#   openssl rand -base64 32
JWT_SECRET=""
JWT_EXPIRES_IN_SECONDS=604800

# Opcionales — credenciales del primer ADMIN sembrado por `npm run seed`
# (prisma/seed.ts). Si no se definen, usa admin@inventario.test / admin1234.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Opcional, default 3000 en src/main.ts. inventario-app corre en :3000 por
# defecto (Next dev) — si corrés ambos en simultáneo, poné uno de los dos en
# otro puerto (ej. PORT=3001 acá, y API_URL="http://localhost:3001" en
# inventario-app/.env.local).
PORT=3000
